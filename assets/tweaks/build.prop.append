# Windows XP Luna Performance & UI Tweaks
# Custom ROM Identification
ro.build.display.id=Windows XP Professional Luna Edition (v1.0)
ro.product.model=Galaxy Tab 3 - Windows XP Edition

# Hide Android virtual navigation bar (hardware keys used for Start/AltTab/Minimize)
qemu.hw.mainkeys=1

# Theme identifier
persist.sys.theme=luna

# Dalvik VM optimizations for 1GB RAM tablet
dalvik.vm.heapgrowthlimit=128m
dalvik.vm.heapsize=256m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=2m
dalvik.vm.heapmaxfree=8m

# Hardware UI acceleration
video.accelerate.hw=1
debug.sf.hw=1
debug.egl.hw=1
