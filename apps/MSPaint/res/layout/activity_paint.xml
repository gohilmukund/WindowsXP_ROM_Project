<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE9D8"
    android:orientation="vertical">

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@drawable/titlebar_bg"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_paint" />

        <TextView
            android:id="@+id/paint_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:text="untitled - Paint"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/paint_btn_minimize"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:text="–"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/paint_btn_maximize"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:text="口"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <Button
            android:id="@+id/paint_btn_close"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_close_bg"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#ECE9D8"
        android:gravity="center_vertical"
        android:paddingLeft="8dp">

        <TextView android:id="@+id/paint_menu_file" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingRight="12dp" android:text="File" android:textColor="#000000" android:textSize="11sp" />
        <TextView android:id="@+id/paint_menu_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingRight="12dp" android:text="Edit" android:textColor="#000000" android:textSize="11sp" />
        <TextView android:id="@+id/paint_menu_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingRight="12dp" android:text="View" android:textColor="#000000" android:textSize="11sp" />
        <TextView android:id="@+id/paint_menu_image" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingRight="12dp" android:text="Image" android:textColor="#000000" android:textSize="11sp" />
        <TextView android:id="@+id/paint_menu_colors" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingRight="12dp" android:text="Colors" android:textColor="#000000" android:textSize="11sp" />
        <TextView android:id="@+id/paint_menu_help" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingRight="12dp" android:text="Help" android:textColor="#000000" android:textSize="11sp" />
    </LinearLayout>

    <!-- Work Area: Left Toolbox + Canvas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Left Toolbox (60dp) -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="#D4D0C8"
            android:orientation="vertical"
            android:padding="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView android:id="@+id/tool_btn_pencil" android:layout_width="26dp" android:layout_height="26dp" android:clickable="true" android:src="@drawable/tool_pencil" />
                <ImageView android:id="@+id/tool_btn_brush" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginLeft="2dp" android:clickable="true" android:src="@drawable/tool_brush" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <ImageView android:id="@+id/tool_btn_eraser" android:layout_width="26dp" android:layout_height="26dp" android:clickable="true" android:src="@drawable/tool_eraser" />
                <ImageView android:id="@+id/tool_btn_bucket" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginLeft="2dp" android:clickable="true" android:src="@drawable/tool_bucket" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <ImageView android:id="@+id/tool_btn_line" android:layout_width="26dp" android:layout_height="26dp" android:clickable="true" android:src="@drawable/tool_line" />
                <ImageView android:id="@+id/tool_btn_rect" android:layout_width="26dp" android:layout_height="26dp" android:layout_marginLeft="2dp" android:clickable="true" android:src="@drawable/tool_rect" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">
                <ImageView android:id="@+id/tool_btn_circle" android:layout_width="26dp" android:layout_height="26dp" android:clickable="true" android:src="@drawable/tool_circle" />
            </LinearLayout>
        </LinearLayout>

        <!-- Canvas -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:background="#808080"
            android:padding="2dp">

            <com.windows.xp.mspaint.PaintView
                android:id="@+id/paint_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Color Palette -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#D4D0C8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <!-- Selected Color Box -->
        <View
            android:id="@+id/color_selected_preview"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="#000000" />

        <!-- 28 Swatches Container -->
        <LinearLayout
            android:id="@+id/palette_swatches_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

</LinearLayout>
