<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fotoo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010">

    <!-- Main Picture Display -->
    <ImageView
        android:id="@+id/fotoo_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- Info & Clock Overlay -->
    <LinearLayout
        android:id="@+id/fotoo_info_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fotoo_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="12:00 PM"
            android:textColor="#EEFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fotoo_filename"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="Photo 1 of 1"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Title Bar -->
    <LinearLayout
        android:id="@+id/fotoo_title_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/titlebar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_fotoo" />

        <TextView
            android:id="@+id/fotoo_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="6dp"
            android:singleLine="true"
            android:text="Fotoo - Windows Picture Viewer"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fotoo_btn_minimize"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="_"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fotoo_btn_maximize"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="口"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fotoo_btn_close"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_close_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Luna Picture Viewer Toolbar -->
    <LinearLayout
        android:id="@+id/fotoo_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:background="#D0ECE9D8"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/fotoo_btn_prev"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#ECE9D8"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="◀ Prev"
            android:textColor="#000000"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fotoo_btn_slideshow"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginLeft="6dp"
            android:background="#ECE9D8"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="▶ Slideshow"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fotoo_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginLeft="6dp"
            android:background="#ECE9D8"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="Next ▶"
            android:textColor="#000000"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fotoo_btn_rotate"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginLeft="6dp"
            android:background="#ECE9D8"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="↻ Rotate"
            android:textColor="#000000"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fotoo_btn_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginLeft="6dp"
            android:background="#ECE9D8"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="⛶ Fullscreen"
            android:textColor="#000000"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
