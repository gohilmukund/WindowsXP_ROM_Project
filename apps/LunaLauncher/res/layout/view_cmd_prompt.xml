<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Scrollable Output Buffer -->
    <ScrollView
        android:id="@+id/scroll_terminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:textColor="#C0C0C0"
            android:textSize="12sp"
            android:typeface="monospace" />
    </ScrollView>

    <!-- Active Command Prompt Input Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_prompt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C:\\Documents and Settings\\Administrator&gt; "
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:typeface="monospace" />

        <EditText
            android:id="@+id/et_cmd_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:cursorVisible="true"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>
</LinearLayout>
