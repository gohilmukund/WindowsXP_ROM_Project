<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#16398A"
                android:endColor="#2152C8" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#0F2864" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3B7AE8"
                android:centerColor="#2A64D8"
                android:endColor="#1E4CB4" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#4F8DF2" />
        </shape>
    </item>
</selector>
