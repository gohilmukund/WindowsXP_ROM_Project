<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#969CAE"
                android:endColor="#B4BACB" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#5F6575" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F4F5F9"
                android:centerColor="#D9DDE6"
                android:endColor="#B9BFCE" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
</selector>
