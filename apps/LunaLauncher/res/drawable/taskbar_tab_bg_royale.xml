<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#002B7A"
                android:endColor="#003B99" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#236ED6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1E6EEB"
                android:centerColor="#0F58D0"
                android:endColor="#0047B3" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#4B90F6" />
        </shape>
    </item>
</selector>
