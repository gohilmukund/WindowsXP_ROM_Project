<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3E5424"
                android:centerColor="#4F6930"
                android:endColor="#62823D" />
            <corners
                android:topRightRadius="14dp"
                android:bottomRightRadius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#2B3C17" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#8BAA62"
                android:centerColor="#6A8A45"
                android:endColor="#4B652C" />
            <corners
                android:topRightRadius="14dp"
                android:bottomRightRadius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#364B1D" />
        </shape>
    </item>
</selector>
