<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#3D5475"
                android:endColor="#24364D" />
            <stroke android:width="1.5dp" android:color="#7795BD" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#2A3B52"
                android:endColor="#162232" />
            <stroke android:width="1.5dp" android:color="#4B6584" />
        </shape>
    </item>
</selector>
