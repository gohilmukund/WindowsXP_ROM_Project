<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1E354D"
                android:endColor="#0D1926" />
            <corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="#4A7AA8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3D4754"
                android:centerColor="#242C35"
                android:endColor="#12171E" />
            <corners android:radius="3dp" />
            <stroke android:width="1dp" android:color="#5A6777" />
        </shape>
    </item>
</selector>
