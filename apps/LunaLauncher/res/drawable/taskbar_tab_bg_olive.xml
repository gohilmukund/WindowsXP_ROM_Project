<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#465F29"
                android:endColor="#5E7E3A" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#2F421A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#9FB97A"
                android:centerColor="#83A15C"
                android:endColor="#658242" />
            <corners android:radius="2dp" />
            <stroke android:width="1dp" android:color="#B2CD8C" />
        </shape>
    </item>
</selector>
