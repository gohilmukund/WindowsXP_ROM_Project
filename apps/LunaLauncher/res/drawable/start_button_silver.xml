<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#7F8596"
                android:centerColor="#9BA1B2"
                android:endColor="#B6BCD0" />
            <corners
                android:topRightRadius="14dp"
                android:bottomRightRadius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#5C6274" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6E8F2"
                android:centerColor="#B8BED0"
                android:endColor="#8E94A8" />
            <corners
                android:topRightRadius="14dp"
                android:bottomRightRadius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#6D7385" />
        </shape>
    </item>
</selector>
