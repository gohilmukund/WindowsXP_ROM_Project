<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="20dp"
                android:startColor="#1E5EA8"
                android:endColor="#0A2244" />
            <stroke android:width="2dp" android:color="#4EA3F2" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="#6AB8EE"
                android:centerColor="#2164A8"
                android:endColor="#0F3360" />
            <stroke android:width="2dp" android:color="#82C8FF" />
        </shape>
    </item>
</selector>
