<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1E5C14"
                android:centerColor="#2D751E"
                android:endColor="#398C27" />
            <corners
                android:topRightRadius="14dp"
                android:bottomRightRadius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#14420E" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#5BB738"
                android:centerColor="#3C8822"
                android:endColor="#296A16" />
            <corners
                android:topRightRadius="14dp"
                android:bottomRightRadius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#1F5410" />
        </shape>
    </item>
</selector>
