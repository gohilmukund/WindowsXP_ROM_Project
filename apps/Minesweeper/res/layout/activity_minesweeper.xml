<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#C0C0C0"
    android:orientation="vertical">

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@drawable/titlebar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_minesweeper" />

        <TextView
            android:id="@+id/ms_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="6dp"
            android:singleLine="true"
            android:text="Minesweeper"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ms_btn_minimize"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="_"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ms_btn_maximize"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="口"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/ms_btn_close"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_close_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#ECE9D8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp">

        <TextView
            android:id="@+id/ms_menu_game"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="Game"
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ms_menu_help"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="Help"
            android:textColor="#000000"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Top Score & Status Panel -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="4dp"
        android:background="@drawable/sunken_border"
        android:padding="4dp">

        <!-- Mine Counter LED -->
        <TextView
            android:id="@+id/ms_led_mines"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:background="#000000"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="010"
            android:textColor="#FF0000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Smiley Face Button -->
        <Button
            android:id="@+id/ms_btn_smiley"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_centerInParent="true"
            android:background="@drawable/sunken_border"
            android:gravity="center"
            android:padding="0dp"
            android:text="🙂"
            android:textSize="18sp" />

        <!-- Timer LED -->
        <TextView
            android:id="@+id/ms_led_timer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:background="#000000"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="000"
            android:textColor="#FF0000"
            android:textSize="22sp"
            android:textStyle="bold"
            android:typeface="monospace" />
    </RelativeLayout>

    <!-- Minefield Canvas -->
    <com.windows.xp.minesweeper.MinefieldView
        android:id="@+id/ms_minefield"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp" />

</LinearLayout>
