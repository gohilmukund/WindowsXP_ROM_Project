<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#007800"
    android:orientation="vertical">

    <!-- Title Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@drawable/titlebar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_solitaire" />

        <TextView
            android:id="@+id/sol_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="6dp"
            android:singleLine="true"
            android:text="Solitaire"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sol_btn_minimize"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="_"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sol_btn_maximize"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_min_max_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="口"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sol_btn_close"
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginLeft="2dp"
            android:background="@drawable/ie_btn_close_bg"
            android:gravity="center"
            android:padding="0dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Menu Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#ECE9D8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp">

        <TextView
            android:id="@+id/sol_menu_game"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="Game"
            android:textColor="#000000"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sol_menu_help"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="Help"
            android:textColor="#000000"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Status Bar (Score & Time) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="#005A00"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/sol_status_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="Score: 0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sol_status_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:text="Time: 0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Solitaire Green Felt Canvas -->
    <com.windows.xp.solitaire.SolitaireView
        android:id="@+id/sol_table_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
